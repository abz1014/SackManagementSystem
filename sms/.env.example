# =============================================================================
# IFL Sack Management System — environment template
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# =============================================================================

# --- app database (OURS — read/write) ---------------------------------------
APP_DB_SERVER=.\SQLEXPRESS
# Required, no default (api/src/config.ts, sync-worker/src/config.ts) — a named
# instance like SQLEXPRESS resolves its own port via SQL Browser, but the
# driver still needs one to be given here. 1433 is SQL Server's standard port;
# check yours if the instance was configured non-default.
APP_DB_PORT=1433
APP_DB_NAME=sms
APP_DB_USER=sms_app
APP_DB_PASSWORD=__set_me__
APP_DB_ENCRYPT=true
APP_DB_TRUST_SERVER_CERTIFICATE=true

# --- IFL source database (sync-worker ONLY — read-only) ----------------------
# THE dev->live switch: in dev this points at the local attached copy;
# in production it points at the plant server\instance. Nothing else changes.
IFL_DB_SERVER=.\SQLEXPRESS
# Required, no default (sync-worker/src/config.ts) — see the APP_DB_PORT note
# above; missing this crashes the sync-worker at startup.
IFL_DB_PORT=1433
IFL_DB_NAME_DATA=DATA_TP1U2
IFL_DB_NAME_PDAS=PDAS_TP1U2
IFL_DB_USER=sms_readonly
IFL_DB_PASSWORD=__set_me__
IFL_DB_ENCRYPT=true
IFL_DB_TRUST_SERVER_CERTIFICATE=true

# ---- PDAS write path (product Add / Retire / Change limits) --------------------
# OFF BY DEFAULT. The one deliberate exception to "the API holds no IFL
# connection": writes go to PDAS_TP1U2.dbo.Materials through the vendor's own
# stored procedures, on a SEPARATE login that IFL's DBA provisions —
# `sms_pdas_writer` with UPDATE/INSERT on dbo.Materials, EXECUTE on
# CreateMaterial + SetMaterialStatusActive, INSERT on dbo.nhs_events, nothing
# else. NEVER reuse IFL_DB_USER here; that login is read-only by policy.
# Leave PDAS_WRITE_ENABLED=false until IFL has confirmed in writing that SMS
# may write to PDAS (SEPT-2026-EPOCH-DECISION §6.2). With it false, or with any
# credential missing, the product screen is read-only and says why.
PDAS_WRITE_ENABLED=false
PDAS_WRITE_SERVER=.\SQLEXPRESS
PDAS_WRITE_PORT=1433
PDAS_WRITE_DATABASE=PDAS_TP1U2
PDAS_WRITE_USER=sms_pdas_writer
PDAS_WRITE_PASSWORD=__set_me__
PDAS_WRITE_ENCRYPT=true
PDAS_WRITE_TRUST_SERVER_CERTIFICATE=true

# --- sync ---------------------------------------------------------------------
# All three are whole numbers, validated at startup (a non-numeric value refuses
# to start; SYNC_INTERVAL_SECONDS used to run a 1 ms loop on a typo). No inline
# comments on these lines: the .env loader takes everything after '=' as the value.
# SYNC_INTERVAL_SECONDS >= 5; SYNC_OVERLAP_ROWS >= 0; LINE_ID >= 1 and stamped on
# every row - set it once and never change it after data has been ingested.
SYNC_INTERVAL_SECONDS=60
SYNC_OVERLAP_ROWS=500
LINE_ID=1
# SYNC_ONCE=true               # dev/CI: run a single pass and exit (default: loop)
# Consecutive failed or halted passes before the worker raises the CRITICAL
# `persistent_sync_failure` finding on Setup › Sync health and the Health
# screen (roadmap Phase 11). Cleared by the next pass that succeeds. Whole
# number >= 1; default 5 (five minutes at the default cadence).
SYNC_FAILURE_CRITICAL_AFTER=5

# --- operations (roadmap Phase 11, 14 Sep 2026) ------------------------------
# Shortest password the app and the CLI accept — the self-service change, the
# admin reset, account creation, `sms user:password`. Length only; IFL has
# not stated a password policy. 6..128, default 10 (replaces the 6 the create
# route used and the "anything non-empty" the CLI accepted).
PASSWORD_MIN_LENGTH=10
# Where scripts\backup-appdb.ps1 writes .bak files. The Health screen reads
# the newest file's age from here (read-only). Match -OutDir / -BackupDir in
# the scripts.
BACKUP_DIR=C:\sms-backups
# `sms retention` (DEPLOY.md, Retention): prune sync_run rows older than this
# many days (the newest row per table is always kept), and non-critical
# dq_finding rows older than this many days. Whole numbers >= 1. Raw and
# canonical readings, audit_log and product_change are NEVER pruned by it.
RETENTION_SYNC_RUN_DAYS=90
RETENTION_DQ_FINDING_DAYS=365

# --- plant simulator (development only; scripts/simulate-plant.mjs) -----------
# The simulator writes synthetic readings into a database whose name MUST end
# in _SIM and refuses any other target. It needs its own writer login on the
# local instance — never the read-only IFL login, and never a plant server.
# SIM_DB_NAME=DATA_TP1U2_SIM
# SIM_DB_USER=sms_sim
# SIM_DB_PASSWORD=__set_me__

# --- api ----------------------------------------------------------------------
API_PORT=4000
CACHE_TTL_SECONDS=5
# Name shown for the line on every screen — SEED ONLY since roadmap Phase 1
# (migration 028): on a fresh database it becomes sms.line.display_name for
# LINE_ID, and from then on Setup › Line is where the name (and the plant and
# unit names) are edited. Once the row exists this value is ignored.
LINE_NAME=TP1 · Line 3 · Unit 2
# Let /api/live?asOf=<ISO> move the plant clock so the floor screens replay a
# past moment. Keep false in production: a wall display left on a replay URL
# would present old numbers as live. Dev sets true, because the supplied copy
# ends on 10 Jul 2026 and the live screens are otherwise empty.
LIVE_ALLOW_AS_OF=false
# Optional cross-check (finding M6, Sep 2026 audit): the plant's known UTC
# offset in minutes (e.g. 300 for UTC+5). If set, the API compares it against
# this host's own OS timezone at startup and logs a loud warning on mismatch —
# the entire two-clocks design (plantClock.ts) assumes they're the same, and a
# mismatch otherwise fails silently by exactly the offset. Leave unset to skip
# the check.
# PLANT_UTC_OFFSET_MINUTES=300
# TRUST_PROXY: believe X-Forwarded-For? Default false, which is correct when
# browsers reach the API directly. It was previously hardcoded true, which made
# req.ip attacker-controlled and the login lockout bypassable by rotating the
# header (proven: 12 failed logins all returned 401 instead of locking out).
# Set true ONLY when a reverse proxy you control terminates TLS in front of this
# service. True with no proxy in front re-opens the bypass.
TRUST_PROXY=false
# COOKIE_SECURE defaults to true (Secure session cookie, requires TLS).
#
# SET THIS TO false FOR A PLAIN-HTTP PLANT INTRANET. Browsers keep Secure
# cookies on http://localhost but DROP them on http://<lan-ip>, so leaving this
# true means the app works on the server itself and login silently fails from
# every other PC — 200 OK, no cookie, straight back to the login screen.
# Keep it true only behind real TLS (or the ngrok review tunnel).
COOKIE_SECURE=true
# Direct TLS termination (see DEPLOY.md's TLS section) — opt-in, two forms.
# Leave everything below unset for plain HTTP, today's default. Set ONE pair,
# not both; setting only half of either pair is a misconfiguration and the
# API just stays on plain HTTP.
#   PFX — Windows-native, no OpenSSL needed (New-SelfSignedCertificate + Export-PfxCertificate):
# TLS_PFX_PATH=C:\sms\certs\sms.pfx
# TLS_PFX_PASSPHRASE=__set_me__
#   PEM — a cert/key pair from OpenSSL or a real CA:
# TLS_CERT_PATH=C:\sms\certs\sms.crt
# TLS_KEY_PATH=C:\sms\certs\sms.key
# WEB_DIST=./web/dist          # production: API also serves the built React app
# (No SESSION_SECRET needed — sessions are server-side random UUIDs, not signed cookies.)

# --- swappable unknowns (see ARCHITECTURE.md §4) ------------------------------
# Q4/Q5 weight basis: as_recorded | gross | net
WEIGHT_BASIS=as_recorded
CONE_TUBE_WEIGHT_G=70
SACK_TARE_KG=0.5
# Q7 shift: corrected | legacy   /   night attribution: start_day | calendar_day
SHIFT_MODE=corrected
SHIFT_NIGHT_BELONGS_TO=start_day

# --- PLC reader stub (Phase 2 — DISABLED; no PLC dependency present) ----------
PLC_READER_ENABLED=false
PLC_HOST=10.1.1.11
PLC_RACK=0
PLC_SLOT=1
PLC_CONE_ID_DB=DB7.DBD10
