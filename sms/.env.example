# =============================================================================
# IFL Sack Management System — environment template
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# =============================================================================

# --- app database (OURS — read/write) ---------------------------------------
APP_DB_SERVER=.\SQLEXPRESS
# Required, no default (api/src/config.ts, sync-worker/src/config.ts) — a named
# instance like SQLEXPRESS resolves its own port via SQL Browser, but the
# driver still needs one to be given here. 1433 is SQL Server's standard port;
# check yours if the instance was configured non-default.
APP_DB_PORT=1433
APP_DB_NAME=sms
APP_DB_USER=sms_app
APP_DB_PASSWORD=__set_me__
APP_DB_ENCRYPT=true
APP_DB_TRUST_SERVER_CERTIFICATE=true

# --- migration login (scripts/migrate.mjs ONLY — fixes defect R-13) -----------
# sms_app (above) no longer holds db_ddladmin: an unattended runtime login
# that can alter schema could also disarm the append-only trigger migration
# 030 puts on sms.audit_log — see db/bootstrap/00_create_app_database.sql's
# header. Schema changes now run as a SEPARATE login, sms_migrate, which
# holds db_ddladmin and is used for nothing except `npm run db:migrate`.
# Set these two only in the shell/session running that one command (never in
# a long-lived .env an unattended service reads) and leave them unset the
# rest of the time; migrate.mjs falls back to APP_DB_USER/PASSWORD if unset,
# which only works while that login still holds db_ddladmin.
# MIGRATE_DB_USER=sms_migrate
# MIGRATE_DB_PASSWORD=__set_me__

# --- IFL source database (sync-worker ONLY — read-only) ----------------------
# THE dev->live switch: in dev this points at the local attached copy;
# in production it points at the plant server\instance. Nothing else changes.
IFL_DB_SERVER=.\SQLEXPRESS
# Required, no default (sync-worker/src/config.ts) — see the APP_DB_PORT note
# above; missing this crashes the sync-worker at startup.
IFL_DB_PORT=1433
IFL_DB_NAME_DATA=DATA_TP1U2
IFL_DB_NAME_PDAS=PDAS_TP1U2
IFL_DB_USER=sms_readonly
IFL_DB_PASSWORD=__set_me__
IFL_DB_ENCRYPT=true
IFL_DB_TRUST_SERVER_CERTIFICATE=true

# ---- PDAS write path (product Add / Retire / Change limits) --------------------
# OFF BY DEFAULT. The one deliberate exception to "the API holds no IFL
# connection": writes go to PDAS through the vendor's own stored procedures,
# on a SEPARATE login that IFL's DBA provisions — `sms_pdas_writer`, exactly
# the nine rights in db/bootstrap/12_pdas_writer.template.sql: EXECUTE on
# CreateMaterial, SetMaterialStatusActive, AddBlend, AddCount, AddTubeType,
# CreatePallet, SetPalletStatusActive; UPDATE on dbo.Materials (the vendor
# ships no UPDATE proc, so a setpoint change is one guarded single-row
# UPDATE); INSERT on dbo.nhs_events (the vendor's own event-log row written
# alongside it) — plus read-back SELECT on dbo.Materials, dbo.Blends,
# dbo.Counts, dbo.TubeTypes, dbo.Pallets. There is deliberately no INSERT on
# dbo.Materials — a new product goes through CreateMaterial, not a raw
# insert. NEVER reuse IFL_DB_USER here; that login is read-only by policy.
# Leave PDAS_WRITE_ENABLED=false until the local end-to-end test of this
# write path has passed against the local database copy (DEFECTS.md D-12;
# IFL's own written permission to proceed was given 19 Sep 2026, see
# handover/PDAS-WRITE-GRANT-2026-09-19.md). With it false, or with any
# credential missing, the product screen is read-only and says why.
PDAS_WRITE_ENABLED=false
# A named instance (e.g. .\SQLEXPRESS or HOST\PDAS) needs SQL Browser
# running to resolve its port, and the `mssql` driver silently drops any
# PDAS_WRITE_PORT you set once an instance name is present. Prefer a plain
# host (or IP) plus an explicit TCP port instead — for local dev that is
# PDAS_WRITE_SERVER=localhost, PDAS_WRITE_PORT=14330 (the local named
# instance's TCP port, found once via SQL Browser or SSMS and then used
# directly so SQL Browser is no longer needed at connect time).
PDAS_WRITE_SERVER=localhost
PDAS_WRITE_PORT=14330
PDAS_WRITE_DATABASE=PDAS_TP1U2
PDAS_WRITE_USER=sms_pdas_writer
PDAS_WRITE_PASSWORD=__set_me__
PDAS_WRITE_ENCRYPT=true
PDAS_WRITE_TRUST_SERVER_CERTIFICATE=true
# Large-change guard (task W1-D, 29 Sep 2026): a limits edit that moves the
# setpoint by more than this percent, or either offset by more than
# PDAS_LIMIT_MAX_OFFSET_CHANGE_G grams, is refused unless the request carries
# largeChangeConfirmed:true and a reason of at least 20 characters. Applies
# whenever the limits route runs, regardless of PDAS_WRITE_ENABLED. Both
# optional; these are the built-in defaults.
PDAS_LIMIT_MAX_SETPOINT_CHANGE_PCT=3
PDAS_LIMIT_MAX_OFFSET_CHANGE_G=20

# --- sync ---------------------------------------------------------------------
# All three are whole numbers, validated at startup (a non-numeric value refuses
# to start; SYNC_INTERVAL_SECONDS used to run a 1 ms loop on a typo). No inline
# comments on these lines: the .env loader takes everything after '=' as the value.
# SYNC_INTERVAL_SECONDS >= 5; SYNC_OVERLAP_ROWS >= 0; LINE_ID >= 1 and stamped on
# every row - set it once and never change it after data has been ingested.
SYNC_INTERVAL_SECONDS=60
SYNC_OVERLAP_ROWS=500
LINE_ID=1
# SYNC_ONCE=true               # dev/CI: run a single pass and exit (default: loop)
# Consecutive failed or halted passes before the worker raises the CRITICAL
# `persistent_sync_failure` finding on Setup › Sync health and the Health
# screen (roadmap Phase 11). Cleared by the next pass that succeeds. Whole
# number >= 1; default 5 (five minutes at the default cadence).
SYNC_FAILURE_CRITICAL_AFTER=5
# Hours without a sack row while cones are being weighed before the worker
# raises the WARNING `sack_blackout` finding (roadmap Phase 7). The sack
# trigger needs all four sack tags, so one missing tag stops every sack row.
# Whole number >= 1; default 4 — the developer's threshold, not IFL's.
SACK_BLACKOUT_HOURS=4

# --- operations (roadmap Phase 11, 14 Sep 2026) ------------------------------
# Shortest password the app and the CLI accept — the self-service change, the
# admin reset, account creation, `sms user:password`. Length only; IFL has
# not stated a password policy. 6..128, default 10 (replaces the 6 the create
# route used and the "anything non-empty" the CLI accepted).
PASSWORD_MIN_LENGTH=10
# Where scripts\backup-appdb.ps1 writes .bak files. The Health screen reads
# the newest file's age from here (read-only). Match -OutDir / -BackupDir in
# the scripts.
BACKUP_DIR=C:\sms-backups
# `sms retention` (DEPLOY.md, Retention): prune sync_run rows older than this
# many days (the newest row per table is always kept), and non-critical
# dq_finding rows older than this many days. Whole numbers >= 1. Raw and
# canonical readings, audit_log and product_change are NEVER pruned by it.
RETENTION_SYNC_RUN_DAYS=90
RETENTION_DQ_FINDING_DAYS=365

# --- plant simulator (development only; scripts/simulate-plant.mjs) -----------
# The simulator writes synthetic readings into a database whose name MUST end
# in _SIM and refuses any other target. It needs its own writer login on the
# local instance — never the read-only IFL login, and never a plant server.
# SIM_DB_NAME=DATA_TP1U2_SIM
# SIM_DB_USER=sms_sim
# SIM_DB_PASSWORD=__set_me__

# --- api ----------------------------------------------------------------------
API_PORT=4000
CACHE_TTL_SECONDS=5
# Name shown for the line on every screen — SEED ONLY since roadmap Phase 1
# (migration 028): on a fresh database it becomes sms.line.display_name for
# LINE_ID, and from then on Setup › Line is where the name (and the plant and
# unit names) are edited. Once the row exists this value is ignored.
LINE_NAME=TP1 · Line 3 · Unit 2
# Let /api/live?asOf=<ISO> move the plant clock so the floor screens replay a
# past moment. Keep false in production: a wall display left on a replay URL
# would present old numbers as live. Dev sets true, because the supplied copy
# ends on 10 Jul 2026 and the live screens are otherwise empty.
LIVE_ALLOW_AS_OF=false
# DEV ONLY, like LIVE_ALLOW_AS_OF above. Lets the floor/live screens (Line,
# Wall, Health, the machine grid) read whichever generation is NEWEST across
# both the real IFL copy and scripts/simulate-plant.mjs's own _SIM database,
# instead of the default rule (always prefer a real generation) — so the
# live screens keep moving while the simulator drives fresh rows on top of a
# frozen real copy. The API refuses it unless BOTH guards hold, checked at
# startup, never assumed (api/src/config.ts's resolveLiveSimulator):
# IFL_DB_NAME_DATA must end in _SIM, and IFL_DB_SERVER must be a local server
# name. Either guard failing degrades this to "off", never a startup crash.
# Reports, the register, reject charts and every other period-scoped read are
# UNAFFECTED — this only ever changes which generation the LIVE "now" screens
# poll (generation.ts's resolveGenerationScope: preferReal is true
# everywhere else, unconditionally). NEVER set this at IFL: it exists only so
# a development machine's own real copy can end (the supplied copy stops
# 7 Sep 2026) without every live screen going quiet during a rehearsal.
# LIVE_ALLOW_SIMULATOR=false
# THE PLANT'S CLOCK, DECLARED — not optional in practice, even though the code
# treats it as skippable. This is what tells the app what timezone the plant
# IS, in minutes east of UTC (e.g. 300 for UTC+5, this plant). Both the API and
# the sync worker compare it against their own host's OS timezone at startup
# (finding M6, Sep 2026 audit; extended to the worker for roadmap H7, 15 Sep
# 2026 — the worker is what actually stamps every reading's production
# timestamp). The whole two-clocks design (shared/src/domain/plantClock.ts)
# assumes the deployment host's timezone equals the plant's; this is the one
# check that verifies it rather than assuming it.
#
# Leaving it unset does not disable anything about the two-clocks design — it
# only disables the ONE THING THAT WOULD CATCH the deployment host being wrong
# instead of the plant. That matters here specifically because IFL's 15 Sep
# answer is that the OWNER SUPPLIES THE PLANT PC, and a freshly imaged Windows
# Server defaults to UTC: on such a host every reading would arrive "five hours
# in the future" relative to the plant clock, silently, until someone notices
# shift attribution or the live status is wrong. Set this on every install; do
# not leave it commented out.
#
# On a mismatch: the API logs a loud warning; the sync worker does the same
# AND raises a standing WARNING dq_finding (visible on the Operations screen,
# cleared automatically once the host's timezone is fixed and the worker is
# restarted). Neither refuses to start — a hard refusal that fires on a
# misconfigured-but-otherwise-working plant PC would be worse than the bug it
# replaces.
PLANT_UTC_OFFSET_MINUTES=300
# TRUST_PROXY: believe X-Forwarded-For? Default false, which is correct when
# browsers reach the API directly. It was previously hardcoded true, which made
# req.ip attacker-controlled and the login lockout bypassable by rotating the
# header (proven: 12 failed logins all returned 401 instead of locking out).
# Set true ONLY when a reverse proxy you control terminates TLS in front of this
# service. True with no proxy in front re-opens the bypass.
TRUST_PROXY=false
# COOKIE_SECURE defaults to true (Secure session cookie, requires TLS).
#
# SET THIS TO false FOR A PLAIN-HTTP PLANT INTRANET. Browsers keep Secure
# cookies on http://localhost but DROP them on http://<lan-ip>, so leaving this
# true means the app works on the server itself and login silently fails from
# every other PC — 200 OK, no cookie, straight back to the login screen.
# Keep it true only behind real TLS (or the ngrok review tunnel).
COOKIE_SECURE=true
# Direct TLS termination (see DEPLOY.md's TLS section) — opt-in, two forms.
# Leave everything below unset for plain HTTP, today's default. Set ONE pair,
# not both; setting only half of either pair is a misconfiguration and the
# API just stays on plain HTTP.
#   PFX — Windows-native, no OpenSSL needed (New-SelfSignedCertificate + Export-PfxCertificate):
# TLS_PFX_PATH=C:\sms\certs\sms.pfx
# TLS_PFX_PASSPHRASE=__set_me__
#   PEM — a cert/key pair from OpenSSL or a real CA:
# TLS_CERT_PATH=C:\sms\certs\sms.crt
# TLS_KEY_PATH=C:\sms\certs\sms.key
# WEB_DIST=./web/dist          # production: API also serves the built React app
# (No SESSION_SECRET needed — sessions are server-side random UUIDs, not signed cookies.)

# --- advanced tuning (added 29 Sep 2026 — read by the code, previously undocumented
# here; see DEFECTS.md Part 11 h) ---------------------------------------------
# These four size the API's OWN mssql connection pool (api/src/config.ts's
# apiPoolOptions/DEFAULT_DB_POOL_MAX — see index.ts's ~line 126 comment on why
# the API does not just inherit the sync-worker's pool defaults, which are
# sized for one single-threaded batch pass, not N concurrent interactive
# readers). Leave commented out to keep the defaults below; uncomment only to
# raise them on a busier install.
# API_DB_POOL_MAX=10
# API_DB_POOL_MIN=1
# API_DB_POOL_IDLE_TIMEOUT_MS=30000
# API_DB_REQUEST_TIMEOUT_MS=30000
# PDF_EDGE_PATH overrides the automatic probe api/src/services/reports/edge.ts
# runs at startup (ProgramFiles(x86) -> ProgramFiles -> LOCALAPPDATA, in that
# order) for the Edge binary the PDF report renderer drives. No default — only
# set this if Edge is installed somewhere none of those three paths cover, or
# to pin a specific copy.
# PDF_EDGE_PATH=C:\path\to\msedge.exe

# --- swappable unknowns (see ARCHITECTURE.md §4) ------------------------------
# Q4/Q5 weight basis: as_recorded | gross | net
WEIGHT_BASIS=as_recorded
CONE_TUBE_WEIGHT_G=70
SACK_TARE_KG=0.5
# Q7 shift: corrected | legacy   /   night attribution: start_day | calendar_day
SHIFT_MODE=corrected
SHIFT_NIGHT_BELONGS_TO=start_day

# --- PLC reader stub (Phase 2 — DISABLED; no PLC dependency present) ----------
PLC_READER_ENABLED=false
PLC_HOST=10.1.1.11
PLC_RACK=0
PLC_SLOT=1
PLC_CONE_ID_DB=DB7.DBD10
