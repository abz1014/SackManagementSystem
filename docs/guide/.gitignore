# Capture tool's cached sign-in state (session cookies) — never commit.
capture/.auth/

# Demo launcher logs (worker T1) — command output, may include local paths.
demo/logs/

# Root .gitignore already ignores *.env everywhere, which covers
# demo/demo.env, demo/demo-secrets.env and demo/demo-login.env. Restated
# here, harmlessly, so this directory's own ignore rules are self-contained.
demo/*.env

# Build output (worker T3) — regenerated by build.ps1 every run.
out/check-report.md
build/__pycache__/
